NODE_ENV=development
PORT=3000

# Allowed browser origin(s) for CORS. Comma-separate to allow more than one.
# Must match the Vite dev server exactly - credentials are enabled, so a
# wildcard origin is not permitted.
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/mydatabase?retryWrites=true&w=majority

JWT_ACCESS_SECRET=cd1096190a830b271ade004c7f286c60fa31ebc46a5ece5de7a42278b1bd32bcbd477c1a62bd06956fd27ce6fcb622978888f17ec52c20ab59ec318879baddae
JWT_REFRESH_SECRET=f0c7979e1bf1f2e65ad323a357e43a844447ae71f63f5c1167c1626f4d83e229b99677efebf2bf99e1b5ff9b9f12914999e96af9e77aa9c8d383470e7f103a96

JWT_ISSUER=logistics-api
JWT_AUDIENCE=logistics-client

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

BCRYPT_ROUNDS=12

# Order pricing. RATE values are fractions, not percentages:
# 0.17 means 17%. Writing 17 is rejected at startup of the first order.
ORDER_SHIPPING_FLAT_FEE=10
ORDER_SHIPPING_PER_UNIT_FEE=1.5
ORDER_STORAGE_RATE=0.03
ORDER_CUSTOMS_RATE=0.05
ORDER_TAX_RATE=0.17

# Request logging. One console line per request; set to false to silence it.
# LOG_REQUEST_BODY also prints the JSON body (passwords/tokens redacted) -
# handy while wiring the frontend up, noisy otherwise.
LOG_REQUESTS=true
LOG_REQUEST_BODY=false

# Used only by `npm run seed:manager` to create the first Logistics Manager.
# Public registration always creates a Vendor, so this is the only way to
# bootstrap a manager account. Password must be at least 8 characters.
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_EMAIL=manager@dohookin.local
SEED_MANAGER_PASSWORD=12345678